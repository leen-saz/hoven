---
import { ClientRouter } from 'astro:transitions';
// الإعدادات ← الاستخدام (المالكة): استهلاك الشهر وحدود الشركة.
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F2F0E3">
<title>الاستخدام · Hoven</title>
<link rel="preload" href="/assets/fonts/ibmplexsansarabic-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
<style is:global>
.us-list{display:grid;gap:12px}
.us{border:1px solid var(--line);border-radius:14px;padding:12px 14px;display:grid;gap:8px}
.us header{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.us header b{flex:1}
.us-bar{height:8px;border-radius:999px;background:var(--tint-2);overflow:hidden}
.us-bar i{display:block;height:100%;background:var(--color-accent);border-radius:999px}
.us-bar.hot i{background:var(--pulse)}
.us small{color:var(--muted)}
.us input{max-width:160px}
</style>
</head>
<body data-page="usagemgr">
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <section class="card pad" style="max-width:720px">
        <h2>استخدام الشهر</h2>
        <p class="muted" style="margin:0 0 12px" id="month"></p>
        <div id="units" class="us-list"></div>
        <p class="muted" style="margin:12px 0 0;font-size:13px">اترك الحد فاضي لو ما تبي حد. لو وصل الاستهلاك للحد، الكتابة بالذكاء الاصطناعي أو توليد الصوت يرجع رسالة بدل ما ينفذ، والباقي يشتغل عادي.</p>
        <div class="bar" style="margin-top:16px"><button class="btn primary" id="save">احفظ الحدود</button></div>
        <div class="msg" id="msg" role="status"></div>
      </section>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
