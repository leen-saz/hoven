---
import { ClientRouter } from 'astro:transitions';
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F2F0E3">
<title>حسابي · Hoven</title>
<link rel="preload" href="/assets/fonts/ibmplexsansarabic-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
</head>
<body data-page="account">
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <section class="card pad" style="max-width:520px">
        <h2>تغيير الباسوورد</h2>
        <p class="muted" id="who" style="margin:0"></p>
        <form id="f" novalidate>
          <label for="cur">الباسوورد الحالي</label><input type="password" id="cur" autocomplete="current-password" required>
          <label for="p1">الباسوورد الجديد</label><input type="password" id="p1" autocomplete="new-password" required>
          <label for="p2">أعد كتابته</label><input type="password" id="p2" autocomplete="new-password" required>
          <div class="bar" style="margin-top:20px"><button class="btn primary" type="submit">احفظ</button></div>
          <div class="msg" id="msg" role="status"></div>
        </form>
      </section>
      <section class="card pad" style="max-width:520px;margin-top:16px">
        <h2>التحقق بخطوتين</h2>
        <p class="muted" id="tstate" style="margin:0">...</p>
        <div id="tstart" hidden>
          <p class="muted" style="margin:8px 0">ضيف الحساب في تطبيق المصادقة (Google Authenticator أو Microsoft Authenticator أو غيره) بهالمفتاح، وبعدها اكتب الكود اللي يطلع.</p>
          <p><code id="tsecret" dir="ltr" style="font-size:16px;letter-spacing:1px"></code> <a id="turi" class="btn sm secondary" href="#">افتحه في التطبيق</a></p>
          <label for="tcode">الكود من 6 أرقام</label><input type="text" id="tcode" inputmode="numeric" autocomplete="one-time-code" maxlength="6" dir="ltr">
          <div class="bar" style="margin-top:12px"><button class="btn primary" type="button" id="tconfirm">فعّل</button></div>
        </div>
        <div id="tcodes" hidden>
          <p><b>كودات الاسترداد.</b> احفظها الحين، ما تنعرض مرة ثانية. كل كود يشتغل مرة وحدة.</p>
          <pre id="tcodelist" dir="ltr" style="margin:0"></pre>
        </div>
        <div id="toff" hidden>
          <label for="tcur">الباسوورد الحالي</label><input type="password" id="tcur" autocomplete="current-password">
          <label for="tcode2">الكود (أو كود استرداد)</label><input type="text" id="tcode2" inputmode="numeric" maxlength="11" dir="ltr">
          <div class="bar" style="margin-top:12px"><button class="btn secondary" type="button" id="tdisable">طفّه</button></div>
        </div>
        <div class="bar" style="margin-top:12px"><button class="btn primary" type="button" id="ton" hidden>فعّل التحقق بخطوتين</button></div>
        <div class="msg" id="tmsg" role="status"></div>
      </section>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
