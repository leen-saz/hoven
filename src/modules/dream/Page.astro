---
import { ClientRouter } from 'astro:transitions';
// احلم: الصفحة الرئيسية. فكرة الحملة ← محادثة تفكير ← أجزاء الحملة (كل جزء «عدّل» و«اعتمد») ← «انشر» (يجي مع ربط المنصات).
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F2F0E3">
<title>احلم · Hoven</title>
<link rel="preload" href="/assets/fonts/ibmplexsansarabic-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/hoven-brand.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
<style is:global>
.dr-note{margin:0 0 16px;border-inline-start:4px solid var(--accent)}
.dr-start{display:grid;gap:14px;max-width:760px}
.dr-start h2{margin:0;font:700 26px/1.3 var(--f-display)}
.dr-start textarea{min-height:120px}
.dr-chips{display:flex;gap:8px;flex-wrap:wrap}
.dr-chips label{display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 14px;border-radius:999px;background:var(--tint);cursor:pointer;margin:0}
.dr-chips input{accent-color:var(--accent)}
.dr-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin:0 0 16px}
.dr-bar select{width:auto;flex:1 1 240px;max-width:420px}
.dr-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:16px;align-items:start}
.dr-chat{display:grid;grid-template-rows:1fr auto;min-height:440px;max-height:75vh;padding:16px}
.dr-log{overflow-y:auto;display:grid;gap:10px;align-content:start;padding:4px 0 12px}
.dr-msg{padding:12px 14px;border-radius:14px;max-width:92%;white-space:pre-wrap;line-height:1.7}
.dr-msg.user{justify-self:start;background:var(--tint)}
.dr-msg.assistant{justify-self:end;background:var(--surface);border:1px solid var(--line)}
.dr-form{display:flex;gap:8px;align-items:flex-end}
.dr-form textarea{min-height:52px}
.dr-parts{padding:16px}
.dr-tabs{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 14px}
.dr-tabs button{display:inline-flex;align-items:center;gap:6px}
.dr-dot{width:8px;height:8px;border-radius:50%;background:var(--line)}
.dr-dot.draft{background:var(--soft)}.dr-dot.approved{background:var(--accent)}.dr-dot.stale{background:var(--pulse)}
.dr-part h3{margin:0 0 6px;font-size:17px}
.dr-part dl{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;margin:0}
.dr-part dt{color:var(--muted)}.dr-part dd{margin:0}
.dr-part ul{margin:6px 0;padding-inline-start:20px}
.dr-item{padding:12px 14px;border-radius:12px;background:var(--tint);margin:0 0 10px}
.dr-acts{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 0}
.dr-tag{font-size:12px;padding:3px 10px;border-radius:999px;background:var(--tint);white-space:nowrap}
.dr-tag.approved{background:color-mix(in srgb,var(--accent) 18%,transparent)}
.dr-tag.stale{background:color-mix(in srgb,var(--pulse) 16%,transparent)}
.dr-publish{margin-top:16px;padding:16px;display:grid;gap:8px}
.dr-progress{margin:8px 0 0}
@media (max-width:1000px){.dr-grid{grid-template-columns:1fr}.dr-chat{max-height:none}}
@media (max-width:640px){.dr-form{flex-direction:column;align-items:stretch}.dr-msg{max-width:100%}}
</style>
</head>
<body data-page="dream" data-module>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <div id="setup"></div>
      <div class="dr-bar" id="bar" hidden>
        <label class="sr-only" for="pick">مشاريعك</label>
        <select id="pick"></select>
        <button class="btn secondary" type="button" id="newBtn">فكرة جديدة</button>
      </div>

      <section class="card pad dr-start" id="start" hidden>
        <h2>وش الحملة اللي تحلم فيها؟</h2>
        <p class="muted" style="margin:0">اكتب الفكرة ونتناقش فيها، وبعدها يطلع لك كل جزء جاهز تعدّله وتعتمده.</p>
        <form id="startForm" class="dr-start" style="gap:12px">
          <label for="idea" class="sr-only">فكرة الحملة</label>
          <textarea id="idea" maxlength="4000" placeholder="مثال: مفارش رمضان بخصم ٢٠٪ للعرسان، أسبوعين قبل رمضان" required></textarea>
          <fieldset class="dr-chips" style="border:0;padding:0;margin:0"><legend class="muted" style="margin-bottom:6px">المنصات</legend>
            <label><input type="checkbox" name="pf" value="meta" checked> ميتا</label>
            <label><input type="checkbox" name="pf" value="snap" checked> سناب شات</label>
            <label><input type="checkbox" name="pf" value="tiktok"> تيك توك</label>
            <label><input type="checkbox" name="pf" value="google"> جوجل</label>
          </fieldset>
          <div><button class="btn primary" type="submit" id="startBtn">ابدأ</button> <span class="muted" id="smsg" role="status"></span></div>
        </form>
      </section>

      <div class="dr-grid" id="work" hidden>
        <section class="card dr-chat" aria-label="المحادثة">
          <div class="dr-log" id="log" aria-live="polite"></div>
          <form class="dr-form" id="ask">
            <label for="q" class="sr-only">رسالتك</label>
            <textarea id="q" maxlength="4000" placeholder="اكتب ردك أو سؤالك…"></textarea>
            <button class="btn primary" type="submit" id="askBtn">أرسل</button>
          </form>
          <p class="muted" id="cmsg" role="status" style="margin:6px 0 0"></p>
        </section>
        <section class="card dr-parts" aria-label="أجزاء الحملة">
          <div class="dr-bar" style="margin-bottom:10px"><h2 style="margin:0;font-size:18px">الحملة</h2><button class="btn primary" type="button" id="prepBtn">جهّز الحملة</button></div>
          <p class="muted dr-progress" id="prog" role="status"></p>
          <div class="dr-tabs" role="tablist" aria-label="أجزاء الحملة" id="tabs"></div>
          <div id="part" class="dr-part"></div>
          <div class="card dr-publish" id="publish"></div>
        </section>
      </div>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
