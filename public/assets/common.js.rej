+try { ME = JSON.parse(sessionStorage.getItem(ME_KEY) || 'null'); } catch { /* storage blocked */ }
+const fetchMe = () => api('/api/account/password').then(v => {
+  ME = { t: Date.now(), v };
+  try { sessionStorage.setItem(ME_KEY, JSON.stringify(ME)); } catch { /* storage blocked */ }
+  return v;
+});
